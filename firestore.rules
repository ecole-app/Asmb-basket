rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  General Manager — règles de sécurité Firestore (multi-club)
//
//  3 niveaux d'accès :
//   1. Super admin (éditeur de la plateforme) : crée les clubs, invite leur
//      dirigeant, peut suspendre un club. N'a AUCUN accès aux données internes
//      d'un club, sauf code d'accès support fourni par ce club (lecture seule).
//   2. Dirigeant d'un club : gère son club, invite son staff.
//   3. Membres (coachs, parents, joueurs) : accès limité à leur club.
//
//  Toutes les données d'un club vivent sous clubs/{clubId}/... .
//  Collections globales : users, clubs, inscription_codes, club_invites,
//  support_grants, buvette_codes.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions communes ──────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function superAdmin() {
      return signedIn() && request.auth.uid == "7f2br1aTiJVWHTEbqVePbMLD0uc2";
    }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function clubPath(clubId) { return /databases/$(database)/documents/clubs/$(clubId); }

    // Un club suspendu (abonnement) n'est plus accessible à ses membres.
    // Le club doit exister ET ne pas etre suspendu. Un simple "n'existe pas donc
    // pas suspendu" rendrait l'acces a un club supprime PLUS large qu'a un club
    // suspendu : ses membres garderaient leurs droits sur des donnees devenues
    // invisibles depuis la plateforme.
    function clubStatus(clubId) {
      return get(clubPath(clubId)).data.get('status', 'active');
    }
    // Le club doit exister ET etre actif. Un simple "n'existe pas donc pas
    // suspendu" rendrait l'acces a un club supprime PLUS large qu'a un club
    // suspendu. 'purging' bloque aussi : pendant l'effacement, les membres ne
    // doivent pas continuer a ecrire dans des collections en cours de purge.
    function notSuspended(clubId) {
      return exists(clubPath(clubId))
        && !(clubStatus(clubId) in ['suspended', 'deleted', 'purging']);
    }

    // Fenetre de purge. Le super admin n'a aucun droit sur les donnees d'un
    // club ; cette fenetre est la seule exception, et elle est bornee :
    //  - le club doit porter le statut 'purging', que seul le super admin pose ;
    //  - purgeUntil doit exister et n'etre pas encore echu, donc la fenetre se
    //    referme d'elle-meme meme si la purge est interrompue ou oubliee ;
    //  - elle ouvre lecture et suppression, jamais l'ecriture : on ne peut pas
    //    modifier les donnees d'un club, seulement les lister et les effacer.
    // Le club voit ce statut depuis son ecran de suspension.
    function purgeWindow(clubId) {
      return superAdmin()
        && exists(clubPath(clubId))
        && clubStatus(clubId) == 'purging'
        && get(clubPath(clubId)).data.get('purgeUntil', request.time) > request.time;
    }
    function member(clubId) {
      return signedIn() && exists(userPath()) && me().get('clubId', null) == clubId && notSuspended(clubId);
    }
    function hasRole(r) { return me().get('roles', []).hasAny([r]); }
    function staff(clubId)     { return member(clubId) && (hasRole('dirigeant') || hasRole('coach')); }
    function dirigeant(clubId) { return member(clubId) && hasRole('dirigeant'); }
    // Accès "bureau" accordé individuellement par le dirigeant (ex. trésorier) à
    // un module précis, en dehors du dirigeant/coach classique. Réservé aux
    // comptes coach ou "bureau" (membre du bureau sans équipe) : jamais à un
    // parent, qui a son propre espace restreint et ne doit jamais pouvoir
    // recevoir ces accès, même via un champ permissions posé par erreur.
    // C'est toujours le dirigeant qui pose permissions.<id>=true sur le compte
    // visé — jamais le compte lui-même (voir la règle update de /users/{uid}).
    function hasPermission(clubId, id) {
      return member(clubId) && (hasRole('coach') || hasRole('bureau'))
        && me().get('permissions', {}).get(id, false) == true;
    }

    // Accès support : le super admin lit un club UNIQUEMENT s'il a ouvert une
    // session avec un code encore valide, que le club n'a pas révoqué.
    function supportActive(clubId) {
      let s = /databases/$(database)/documents/clubs/$(clubId)/support_sessions/$(request.auth.uid);
      return superAdmin() && exists(s)
        && get(s).data.expiresAt > request.time
        && exists(/databases/$(database)/documents/support_grants/$(get(s).data.code));
    }
    function readMember(clubId)    { return member(clubId)    || supportActive(clubId); }
    function readStaff(clubId)     { return staff(clubId)     || supportActive(clubId); }
    function readDirigeant(clubId) { return dirigeant(clubId) || supportActive(clubId); }

    // Indépendant (micro-entreprise) : même structure qu'un club (clubs/{id}),
    // avec type 'independant', posé par le super admin à la création.
    function indep(clubId) { return get(clubPath(clubId)).data.get('type', 'club') == 'independant'; }
    function lienIndep(code) { return /databases/$(database)/documents/indep_liens/$(code); }

    // ── Messagerie (canaux et discussions privées) ──
    // Les autres membres ne touchent qu'aux champs partagés : réactions, votes
    // de sondage, réponses de convocation, places de covoiturage.
    function champsPartages() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['reactions','options','responses','passagers']);
    }
    // L'auteur modifie son texte pendant 2 minutes, et peut le supprimer
    // (pour tout le monde) quand il veut : le contenu est alors effacé.
    function auteurPeut() {
      return resource.data.get('senderUid', null) == request.auth.uid
        && request.resource.data.get('senderUid', null) == request.auth.uid
        && (
          (request.time < resource.data.ts + duration.value(2, 'm')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','editedAt']))
          || (request.resource.data.get('deleted', false) == true
            && request.resource.data.get('deletedByAdmin', false) == false
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleted','deletedBy','deletedAt','text','mediaUrl','fileName','question','replyTo']))
        );
    }

    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Code d'accès caisse buvette (généré par le dirigeant, valable une journée) :
    // la caisse buvette (generalmanagerapp.fr/buvette) n'a aucun compte, donc aucune connexion. Le
    // code est la seule barrière — il doit exister pour ce club et n'être pas
    // encore expiré.
    // Club en accès limité : la caisse buvette ne fonctionne que si le module
    // "Caisse buvette" a été gardé par la plateforme.
    function buvetteOuverte(clubId) {
      let c = get(/databases/$(database)/documents/clubs/$(clubId)).data;
      // Abonnement gelé par le dirigeant (aboGelFin dans le futur) = accès limité.
      let gele = c.get('aboGelFin', 0) is number && c.get('aboGelFin', 0) > request.time.toMillis();
      return (c.get('plan', '') != 'limite' && !gele) || c.get('modulesLimites', {}).get('buvette', false) == true;
    }
    function buvetteCodeValid(clubId, code) {
      return code is string && code != ''
        && exists(/databases/$(database)/documents/buvette_codes/$(code))
        && get(/databases/$(database)/documents/buvette_codes/$(code)).data.clubId == clubId
        && get(/databases/$(database)/documents/buvette_codes/$(code)).data.expiresAt > request.time
        && buvetteOuverte(clubId);
    }

    // Invitation valide pour ce club et ce rôle (non utilisée, non expirée)
    function invitePath(code) { return /databases/$(database)/documents/club_invites/$(code); }
    function inviteValid(code, clubId, roles) {
      let inv = get(invitePath(code)).data;
      return inv.usedBy == null && inv.expiresAt > request.time
        && inv.clubId == clubId && roles == [inv.role];
    }

    // Élèves rattachés par une invitation (playerIds, ou playerId seul)
    function inviteIds(inv) {
      return inv.get('playerIds', []).concat(inv.get('playerId', null) == null ? [] : [string(inv.playerId)]);
    }
    // Un compte existant du MÊME club accepte une invitation : le rôle s'ajoute, rien d'autre ne bouge.
    function accepteInvitation(uid) {
      let code = request.resource.data.get('inviteCode', '');
      let inv = get(invitePath(code)).data;
      let avant = resource.data;
      return signedIn() && request.auth.uid == uid
        && code is string && code.size() > 0
        && request.resource.data.diff(avant).affectedKeys().hasOnly(['roles','permissions','linkedPlayerIds','inviteCode'])
        && inv.usedBy == null && inv.expiresAt > request.time
        && inv.clubId == avant.get('clubId', null)
        && getAfter(invitePath(code)).data.usedBy == request.auth.uid
        && request.resource.data.roles.hasAll(avant.get('roles', []))
        && request.resource.data.roles.hasOnly(avant.get('roles', []).concat([inv.role]))
        && request.resource.data.permissions.diff(avant.get('permissions', {})).affectedKeys().hasOnly(inv.get('grantedPermissions', {}).keys())
        && request.resource.data.linkedPlayerIds.toSet().difference(avant.get('linkedPlayerIds', []).toSet()).difference(inviteIds(inv).toSet()).size() == 0;
    }

    // Un autre compte dirigeant du même club (pour qu'un dirigeant puisse quitter son rôle).
    function autreDirigeant(autre, clubId) {
      return autre is string && autre.size() > 0 && autre != request.auth.uid
        && get(/databases/$(database)/documents/users/$(autre)).data.get('clubId', null) == clubId
        && get(/databases/$(database)/documents/users/$(autre)).data.get('roles', []).hasAny(['dirigeant']);
    }

    // ── Comptes utilisateurs ────────────────────────────────────────
    match /users/{uid} {
      // Le staff (dirigeant, coach) voit les comptes de son club : il en a besoin
      // pour ouvrir une discussion privée avec un parent.
      allow read: if signedIn()
        && (request.auth.uid == uid || staff(resource.data.get('clubId', null)) || superAdmin());

      // a) [retiré] L'auto-inscription par numéro de téléphone (phone_index)
      //    n'existe plus : parents comme joueurs rejoignent par invitation
      //    (branche b), émise par le club une fois la licence validée.
      // b) Staff invité (et désormais parent/joueur) : invitation valide ET
      //    consommée dans la même opération
      //    (écriture groupée) — une invitation ne sert donc qu'une fois.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.inviteCode is string
        && inviteValid(request.resource.data.inviteCode, request.resource.data.clubId, request.resource.data.roles)
        && getAfter(invitePath(request.resource.data.inviteCode)).data.usedBy == request.auth.uid
        // La personne qui accepte un lien ne choisit pas ses propres accès :
        // permissions/titre doivent être exactement ceux posés par le dirigeant
        // sur l'invitation elle-même (grantedPermissions), jamais autre chose.
        && request.resource.data.get('permissions', {}) == get(invitePath(request.resource.data.inviteCode)).data.get('grantedPermissions', {})
        && request.resource.data.get('titre', null) == null
        // Le numero rattache le compte aux enfants (rattachements/{tel}) : c'est
        // celui pose par le club sur l'invitation, jamais un numero choisi.
        && request.resource.data.get('phone', '') == get(invitePath(request.resource.data.inviteCode)).data.get('tel', '');
      // c) Compte d'origine du super admin : recréation à l'identique du seed
      //    posé par applyAuthedUser() (même après suppression), jamais avec un
      //    autre club ou un autre rôle — sinon la restriction de l'update
      //    ci-dessous se contournerait par un delete + create.
      allow create: if superAdmin() && request.auth.uid == uid
        && request.resource.data.clubId == "asmb"
        && request.resource.data.roles == ["dirigeant"];
      // d) Client d'un indépendant : compte créé avec le lien (QR code) que
      //    l'indépendant partage. Le lien doit être actif et appartenir à un
      //    indépendant ; le compte n'a que le rôle « client », sans aucun accès.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','phone','roles','clubId','joinCode','linkedPlayerIds','linkedTeamIds','permissions','titre','createdAt'])
        && request.resource.data.roles == ['client']
        && request.resource.data.joinCode is string
        && exists(lienIndep(request.resource.data.joinCode))
        && get(lienIndep(request.resource.data.joinCode)).data.actif == true
        && get(lienIndep(request.resource.data.joinCode)).data.clubId == request.resource.data.clubId
        && indep(request.resource.data.clubId) && notSuspended(request.resource.data.clubId)
        && request.resource.data.get('phone', '') == ''
        && request.resource.data.get('permissions', {}) == {}
        && request.resource.data.get('titre', null) == null
        && request.resource.data.get('linkedPlayerIds', []) == []
        && request.resource.data.get('linkedTeamIds', []) == [];

      // Le super admin ne peut pas s'attribuer un clubId à volonté : seul le
      // rattachement unique du compte bootstrap (clubId absent -> club d'origine)
      // est autorisé, exactement ce que fait applyAuthedUser() au premier login.
      // Tout autre club se rejoint via une invitation (branche b ci-dessus).
      allow update: if (signedIn() && request.auth.uid == uid && !changes(['roles','clubId','inviteCode','linkedPlayerIds','permissions','titre','phone']))
        // Un dirigeant ne quitte SON rôle que si un autre dirigeant du club est déjà en place (remplacePar).
        || (dirigeant(resource.data.get('clubId', null)) && request.resource.data.clubId == resource.data.get('clubId', null)
            && (request.auth.uid != uid || request.resource.data.get('roles', []).hasAll(['dirigeant'])
                || autreDirigeant(request.resource.data.get('remplacePar', ''), resource.data.get('clubId', null))))
        // Le super admin récupère toujours son rôle de dirigeant sur son propre compte (même club).
        || (superAdmin() && request.auth.uid == uid
            && request.resource.data.get('roles', []).hasAll(['dirigeant'])
            && request.resource.data.get('clubId', null) == resource.data.get('clubId', null))
        // Le coach peut corriger le numéro d'un compte de son club (et rien d'autre).
        || (staff(resource.data.get('clubId', null))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone']))
        || (superAdmin() && request.auth.uid == uid
            && resource.data.get('clubId', null) == null && request.resource.data.clubId == "asmb"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubId']))
        || accepteInvitation(uid);
      // Le dirigeant retire l'accès d'un compte de son club (jamais un dirigeant, jamais le sien) :
      // l'adresse e-mail pourra être réinvitée (« J'ai déjà un compte »).
      // Le dirigeant retire l'accès de n'importe quel compte de son club (y compris un
      // autre dirigeant), jamais le sien ni celui du super admin.
      allow delete: if superAdmin()
        || (dirigeant(resource.data.get('clubId', null)) && request.auth.uid != uid
            && uid != "7f2br1aTiJVWHTEbqVePbMLD0uc2");
    }

    // ── Réglages de la Plateforme (RIB pour les virements d'abonnement) ──
    // Écrits par le super admin seul ; lus par les dirigeants connectés (écran Abonnement).
    match /plateforme_config/{id} {
      allow read: if superAdmin() || (signedIn() && hasRole('dirigeant'));
      allow write: if superAdmin();
    }

    // ── Comptabilité de la micro-entreprise (Plateforme › Comptabilité) ──
    // Lignes de factures/recettes + document _config (nom, SIRET, adresse).
    // Super admin seul : aucun club n'y accède.
    match /pf_compta/{id} {
      allow read, write: if superAdmin();
    }

    // ── Test d'alerte push (bouton « Tester » de la Plateforme) ──
    match /plateforme_ping/{id} {
      allow create: if superAdmin() && request.resource.data.keys().hasOnly(['at']);
      allow read: if superAdmin();
    }

    // ── Alertes push de la Plateforme (un abonnement par appareil du super admin) ──
    match /plateforme_push/{uid} {
      allow read, write: if superAdmin() && request.auth.uid == uid;
    }

    // ── Comptes de connexion à supprimer à la main (club supprimé) ──
    match /comptes_a_supprimer/{id} {
      allow read, write: if superAdmin();
    }

    // ── Demandes d'essai déposées depuis le site (accueil.generalmanagerapp.fr) ──
    // Formulaire public : création seule, contenu strictement contrôlé. Seul le
    // super admin les lit et les traite (Plateforme).
    match /demandes_essai/{id} {
      function couleurOk(c) { return c == null || (c is string && c.matches('^#[0-9a-fA-F]{6}$')); }
      function lienOk(l) { return l is string && l.size() <= 200; }
      // Réseaux sociaux et boutique du club (facultatifs) : 5 liens au plus, texte court.
      function liensOk(d) {
        return !('liens' in d) || (d.liens is map
          && d.liens.keys().hasOnly(['facebook','instagram','tiktok','site','boutique'])
          && lienOk(d.liens.get('facebook','')) && lienOk(d.liens.get('instagram',''))
          && lienOk(d.liens.get('tiktok','')) && lienOk(d.liens.get('site',''))
          && lienOk(d.liens.get('boutique','')));
      }
      allow create: if request.resource.data.keys().hasOnly(['club','sport','ville','licencies','couleur','couleur2','liens','nom','tel','email','statut','at'])
        && liensOk(request.resource.data)
        && request.resource.data.club is string && request.resource.data.club.size() >= 2 && request.resource.data.club.size() <= 80
        && request.resource.data.sport is string && request.resource.data.sport.size() <= 30
        && request.resource.data.get('ville', '') is string && request.resource.data.get('ville', '').size() <= 60
        && request.resource.data.get('licencies', 0) is int && request.resource.data.get('licencies', 0) >= 0 && request.resource.data.get('licencies', 0) <= 5000
        && couleurOk(request.resource.data.get('couleur', null)) && couleurOk(request.resource.data.get('couleur2', null))
        && request.resource.data.nom is string && request.resource.data.nom.size() >= 2 && request.resource.data.nom.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.matches('^[+]?[0-9]{9,15}$')
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 100
        && request.resource.data.statut == 'nouvelle'
        && request.resource.data.at == request.time;
      allow read, update, delete: if superAdmin();
    }

    // ── Avis et suggestions des membres (dirigeants, coachs, parents), adressés à l'équipe General Manager ──
    match /avis_plateforme/{id} {
      allow create: if member(request.resource.data.clubId)
        && request.resource.data.keys().hasOnly(['clubId','clubName','uid','email','message','statut','ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 2000
        && request.resource.data.statut == 'nouveau'
        && request.resource.data.ts == request.time;
      allow read, update, delete: if superAdmin();
    }

    // ── Invitations (usage unique, expirent) ────────────────────────
    match /club_invites/{code} {
      allow get: if true;   // consultation par code uniquement (pas de listing public)
      allow list: if superAdmin() || dirigeant(resource.data.clubId)
        || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if request.resource.data.usedBy == null
        && (superAdmin()
            || (dirigeant(request.resource.data.clubId)
                && request.resource.data.role in ['coach','dirigeant','parent','bureau'])
            // Un parent ouvre l'acces de SON enfant. C'est le club qui dit lesquels
            // sont les siens, via le rattachement : le compte ne peut pas se
            // l'attribuer lui-meme, et ne peut donc pas viser l'enfant d'un autre.
            || (request.resource.data.role == 'joueur'
                && member(request.resource.data.clubId)
                && request.resource.data.createdBy == request.auth.uid
                && request.resource.data.playerId in
                     get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)/rattachements/$(me().get('phone',''))).data.get('playerIds', [])));
      // Consommation : uniquement par la personne qui crée son compte, dans la
      // même opération que la création de ce compte.
      allow update: if signedIn() && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if superAdmin() || dirigeant(resource.data.clubId)
        || (signedIn() && resource.data.createdBy == request.auth.uid && resource.data.usedBy == null);
    }

    // ── Indépendants : lien d'invitation des clients (réutilisable, QR code) ──
    // Quiconque a le lien peut créer un compte client de CET indépendant, tant
    // que l'indépendant le laisse actif. Lu par son code, jamais listé en public.
    match /indep_liens/{code} {
      allow get: if true;
      allow list: if dirigeant(resource.data.clubId) || purgeWindow(resource.data.clubId);
      allow create: if dirigeant(request.resource.data.clubId) && indep(request.resource.data.clubId)
        && code.matches('^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(['clubId','clubName','couleur','actif','createdBy','createdAt'])
        && request.resource.data.actif == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('clubName', '') is string && request.resource.data.get('clubName', '').size() <= 80
        && request.resource.data.get('couleur', '') is string && request.resource.data.get('couleur', '').size() <= 7;
      allow update: if dirigeant(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actif','clubName','couleur'])
        && request.resource.data.actif is bool;
      allow delete: if dirigeant(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Codes d'accès support (générés par le club) ─────────────────
    match /support_grants/{code} {
      allow get: if superAdmin();                        // uniquement si on connaît le code
      allow list: if dirigeant(resource.data.clubId) || purgeWindow(resource.data.clubId);    // le club voit ses codes actifs
      allow create: if dirigeant(request.resource.data.clubId);
      // Révocation normale par le dirigeant, OU purge du club par le super admin
      // (deleteClubFlow) : sans purgeWindow, dirigeant(clubId) redevient faux dès
      // que le club passe en "purging", et la purge de ces codes échouait.
      allow delete: if dirigeant(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Codes d'accès caisse buvette (générés par le club) ───────────
    match /buvette_codes/{code} {
      allow get: if true;                                 // le site caisse buvette n'a pas de connexion : le code protège l'accès
      allow list: if dirigeant(resource.data.clubId) || purgeWindow(resource.data.clubId);      // le club voit ses codes actifs pour les révoquer
      allow create: if dirigeant(request.resource.data.clubId);
      allow delete: if dirigeant(resource.data.clubId) || purgeWindow(resource.data.clubId);    // révocation, ou purge du club
    }

    // ── Page publique d'un événement à inscription (stage, tournoi, soirée) ──
    // Id = <clubId>__<eventId>. Lisible par son lien ; le staff du club la publie.
    // Seule écriture publique : +1 au compteur d'inscrits, dans la même opération
    // que la création de l'inscription correspondante (et jamais au-delà des places).
    match /evt_pages/{pid} {
      allow get: if true;
      allow list: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);   // purge du club
      allow create: if staff(request.resource.data.clubId)
        && pid == request.resource.data.clubId + '__' + request.resource.data.eventId;
      allow update: if (staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId
                          && request.resource.data.eventId == resource.data.eventId)
        || (resource.data.actif == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nb','dernier','nbJ'])
            && request.resource.data.nb == resource.data.get('nb', 0)
                 + getAfter(/databases/$(database)/documents/clubs/$(resource.data.clubId)/evt_inscrits/$(request.resource.data.dernier)).data.get('personnes', 1)
            // Choix des jours : les places se comptent par jour (nbJ, côté appli) ; le total n'est pas borné.
            && (resource.data.get('parJour', false) == true || resource.data.get('places', 0) == 0 || request.resource.data.nb <= resource.data.places)
            // nbJ ne peut bouger que pour les jours du billet créé dans la même opération.
            && (!('nbJ' in request.resource.data.diff(resource.data).affectedKeys())
                || (resource.data.get('parJour', false) == true
                    && request.resource.data.nbJ.diff(resource.data.get('nbJ', {})).affectedKeys()
                         .hasOnly(getAfter(/databases/$(database)/documents/clubs/$(resource.data.clubId)/evt_inscrits/$(request.resource.data.dernier)).data.jours)))
            && existsAfter(/databases/$(database)/documents/clubs/$(resource.data.clubId)/evt_inscrits/$(request.resource.data.dernier))
            && !exists(/databases/$(database)/documents/clubs/$(resource.data.clubId)/evt_inscrits/$(request.resource.data.dernier)));
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Pass bénévole (generalmanagerapp.fr/benevole/?p=CODE) ───────────
    // Un lien (ou QR) par bénévole : ses missions à venir, sans téléphone ni donnée
    // sensible. Lisible par son code (non devinable) ; le staff du club le publie.
    // Seule écriture publique : la réponse du bénévole (oui / non) à chaque mission.
    match /ben_pass/{code} {
      function passCles(d) {
        return d.keys().hasOnly(['clubId','clubName','couleur','benId','nom','actif','missions','reponses','majLe','createdAt'])
          && d.clubId is string && d.clubId.size() > 0
          && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 60
          && d.actif is bool
          && d.missions is list && d.missions.size() <= 40
          && d.get('reponses', {}) is map && d.get('reponses', {}).size() <= 60;
      }
      allow get: if true;
      allow list: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
      allow create: if staff(request.resource.data.clubId)
        && code.matches('^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$')
        && passCles(request.resource.data);
      allow update: if (staff(resource.data.clubId)
                          && request.resource.data.clubId == resource.data.clubId
                          && request.resource.data.benId == resource.data.benId
                          && passCles(request.resource.data))
        || (resource.data.actif == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponses'])
            && request.resource.data.reponses is map
            && request.resource.data.reponses.size() <= 60
            && request.resource.data.reponses.values().hasOnly(['oui','non']));
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Planning public d'un tournoi (?trn=clubId__eventId) ─────────
    // Équipes, poules et horaires, sans donnée personnelle : lisible par tous,
    // écrit par le staff du club seulement.
    match /trn_pages/{pid} {
      allow get: if true;
      allow list: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
      allow create: if staff(request.resource.data.clubId)
        && pid == request.resource.data.clubId + '__' + request.resource.data.eventId;
      allow update: if staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId
        && request.resource.data.eventId == resource.data.eventId;
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Match d'un tournoi : id = code de table de marque (secret, 6 caractères) ──
    // Lisible seulement avec le code (pas de listing hors staff). Sans compte, la
    // table ne peut que saisir le score et clôturer ; une fois clôturé, seul le
    // staff du club peut rouvrir, corriger ou déclarer un forfait.
    match /trn_matchs/{code} {
      allow get: if code.matches('^[A-HJ-NP-Z2-9]{6}$');
      allow list: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
      allow create: if staff(request.resource.data.clubId) && code.matches('^[A-HJ-NP-Z2-9]{6}$');
      allow update: if (staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId
                          && request.resource.data.eventId == resource.data.eventId)
        || (resource.data.statut != 'termine'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sa','sb','statut','clotureLe','majLe','stats'])
            && (!('stats' in request.resource.data) || (request.resource.data.stats is map && request.resource.data.stats.size() <= 2))
            && request.resource.data.sa is int && request.resource.data.sb is int
            && request.resource.data.sa >= 0 && request.resource.data.sa <= 250
            && request.resource.data.sb >= 0 && request.resource.data.sb <= 250
            && request.resource.data.statut in ['encours', 'termine']);
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Résultat d'un match clôturé, publié pour la page publique du tournoi ──
    // id = clubId__eventId__matchId. La table de marque l'écrit à la clôture :
    // la règle vérifie que trn_matchs/{code} est bien clôturé avec le même score
    // (le code ne sert plus à rien une fois le match clôturé). Ainsi les
    // résultats et classements s'affichent même sans l'écran « Jour J » ouvert.
    // Pendant le match, la table de marque publie aussi le score en cours avec
    // statut:'encours' : la règle exige alors trn_matchs/{code} en cours, même score.
    match /trn_live/{id} {
      function liveCles(lid, d) { return d.keys().hasOnly(['clubId','eventId','matchId','sa','sb','forfait','code','le','stats','statut'])
        && (!('statut' in d) || d.statut == 'encours')
        && (!('stats' in d) || (d.stats is map && d.stats.size() <= 2))
        && d.clubId is string && d.eventId is string && d.matchId is string
        && lid == d.clubId + '__' + d.eventId + '__' + d.matchId.replace('/', '_')
        && d.sa is int && d.sb is int && d.sa >= 0 && d.sa <= 250 && d.sb >= 0 && d.sb <= 250; }
      function liveTable(d) { return d.code is string && d.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && !('forfait' in d)
        && existsAfter(/databases/$(database)/documents/trn_matchs/$(d.code))
        && getAfter(/databases/$(database)/documents/trn_matchs/$(d.code)).data.statut == d.get('statut', 'termine')
        && getAfter(/databases/$(database)/documents/trn_matchs/$(d.code)).data.clubId == d.clubId
        && getAfter(/databases/$(database)/documents/trn_matchs/$(d.code)).data.eventId == d.eventId
        && getAfter(/databases/$(database)/documents/trn_matchs/$(d.code)).data.matchId == d.matchId
        && getAfter(/databases/$(database)/documents/trn_matchs/$(d.code)).data.sa == d.sa
        && getAfter(/databases/$(database)/documents/trn_matchs/$(d.code)).data.sb == d.sb; }
      allow get, list: if true;
      allow create: if liveCles(id, request.resource.data)
        && (staff(request.resource.data.clubId) || liveTable(request.resource.data));
      allow update: if liveCles(id, request.resource.data) && request.resource.data.clubId == resource.data.clubId
        && (staff(resource.data.clubId) || liveTable(request.resource.data));
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Joueurs d'une équipe inscrite par le lien : id = code « Mon équipe » ──
    // Le responsable (sans compte) lit et modifie ses joueurs avec son code, tant que
    // le tournoi n'a pas commencé (verrou posé par le staff). Pas de listing public.
    match /trn_equipes/{code} {
      function equipeJoueursOk(d) { return d.joueurs is list && d.joueurs.size() <= 15; }
      allow get: if code.matches('^[A-HJ-NP-Z2-9]{6}$');
      allow list: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
      allow create: if code.matches('^[A-HJ-NP-Z2-9]{6}$') && (staff(request.resource.data.clubId)
        || (request.resource.data.keys().hasOnly(['clubId','eventId','inscId','nom','cat','joueurs','majLe'])
            && equipeJoueursOk(request.resource.data)
            && request.resource.data.nom is string && request.resource.data.nom.size() <= 40
            && get(/databases/$(database)/documents/trn_pages/$(request.resource.data.clubId + '__' + request.resource.data.eventId)).data.get('inscrOuvertes', false) == true));
      allow update: if (staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId)
        || (resource.data.get('verrou', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joueurs','majLe'])
            && equipeJoueursOk(request.resource.data));
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Inscription d'une équipe à un tournoi, par le lien public ─────
    // Possible seulement si le club a ouvert les inscriptions sur la page publique.
    // Le contact du responsable n'est lisible que par le staff du club.
    match /trn_inscriptions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['clubId','eventId','nom','club','cat','contact','tel','email','at','joueurs','code'])
        && (!('joueurs' in request.resource.data) || (request.resource.data.joueurs is list && request.resource.data.joueurs.size() <= 15))
        && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{6}$')))
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 40
        && request.resource.data.club is string && request.resource.data.club.size() <= 50
        && request.resource.data.cat is string && request.resource.data.cat.size() <= 20
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 20
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 100
        && get(/databases/$(database)/documents/trn_pages/$(request.resource.data.clubId + '__' + request.resource.data.eventId)).data.get('inscrOuvertes', false) == true
        && request.resource.data.cat in get(/databases/$(database)/documents/trn_pages/$(request.resource.data.clubId + '__' + request.resource.data.eventId)).data.get('catsInscr', []);
      allow read, delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Code bénévole pour l'entrée d'un événement (sans compte) ─────
    // Id = code secret (XXXX-XXXX) transmis par le staff, valable jusqu'au
    // lendemain de l'événement. Le doc contient la liste figée des billets
    // (prénom, nom, tarif, payé : pas de téléphone). Le bénévole ne peut
    // que cocher les présents et les paiements reçus sur place (maps
    // presents / payes) ; le club les reporte ensuite sur les billets.
    match /evt_entrees/{code} {
      allow get: if code.matches('^[A-Z2-9]{4}-[A-Z2-9]{4}$');
      allow list: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
      allow create: if staff(request.resource.data.clubId) && code.matches('^[A-Z2-9]{4}-[A-Z2-9]{4}$')
        && request.resource.data.expiresAt is timestamp;
      allow update: if (staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId)
        || (resource.data.expiresAt > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presents','payes'])
            && request.resource.data.presents is map && request.resource.data.payes is map
            && request.resource.data.presents.size() <= 3000 && request.resource.data.payes.size() <= 3000);
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // ── Page publique « Venir essayer » d'un club (id = clubId) ─────
    // Lisible par tous via son lien (pas de listing) ; seul le dirigeant la publie.
    // Contient uniquement ce que le club choisit d'afficher (nom, logo, couleurs,
    // réseaux, équipes et créneaux) : aucune donnée de membre.
    match /essai_pages/{clubId} {
      allow get: if true;
      allow create, update: if dirigeant(clubId) || superAdmin();
      allow delete: if dirigeant(clubId) || purgeWindow(clubId);
    }

    // ── Clubs ───────────────────────────────────────────────────────
    // Abonnement géré par le dirigeant (Paramètres › Abonnement) : gel,
    // relance, résiliation. Il ne touche jamais au pack ni à l'échéance.
    // Seuls les champs réellement modifiés sont vérifiés (k = clés changées).
    function aboChampsValides(d, k) {
      return (!k.hasAny(['aboGels']) || (d.aboGels is list && d.aboGels.size() <= 30))
        && (!k.hasAny(['aboGelFin']) || d.aboGelFin is number)
        && (!k.hasAny(['aboResiliation']) || d.aboResiliation == null || d.aboResiliation is map)
        && (!k.hasAny(['aboNotif']) || (d.aboNotif is map && d.aboNotif.get('vu', false) == false));
    }
    match /clubs/{clubId} {
      allow read: if member(clubId) || superAdmin();
      allow create, delete: if superAdmin();
      // Le dirigeant personnalise son club ; tout le reste (statut, formule,
      // propriétaire, essai, délai de régularisation, échéance d'abonnement...)
      // est du ressort de la plateforme. Liste blanche : un champ ajouté plus
      // tard sur la fiche club est refusé au dirigeant tant qu'il n'est pas
      // listé ici (couvert par tests/rules).
      allow update: if (dirigeant(clubId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name','zone','departement','couleur','couleur2','logo','lienPaiement','liens','cerfa','facturation','relances','aides','polesCoachs',
                         'aboGels','aboGelFin','aboResiliation','aboNotif'])
          && aboChampsValides(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()))
        || superAdmin();

      // Session support ouverte par le super admin avec un code valide du club
      match /support_sessions/{uid} {
        allow create: if superAdmin() && request.auth.uid == uid
          && get(/databases/$(database)/documents/support_grants/$(request.resource.data.code)).data.clubId == clubId
          && request.resource.data.expiresAt ==
               get(/databases/$(database)/documents/support_grants/$(request.resource.data.code)).data.expiresAt;
        allow read: if (superAdmin() && request.auth.uid == uid) || dirigeant(clubId);
        allow delete: if (superAdmin() && request.auth.uid == uid) || dirigeant(clubId);
      }

      // ── Données sportives ──
      // La fiche joueur complete porte la date de naissance, les telephones et
      // les notes du staff : elle est reservee au staff. Ce que les familles ont
      // besoin de voir (nom, prenom, categorie, photo si autorisee) vit dans
      // "roster", derive de cette fiche a chaque enregistrement.
      match /players/{id}      { allow read: if readStaff(clubId);  allow write: if staff(clubId); }
      match /roster/{id}       { allow read: if readMember(clubId); allow write: if staff(clubId); }

      // Rattachement d'un numero a ses fiches joueur : un parent a ses enfants,
      // un joueur a la sienne. L'identifiant du document est le numero lui-meme,
      // et la regle verifie qu'il s'agit bien de celui du demandeur — personne
      // ne peut donc parcourir les rattachements des autres.
      match /rattachements/{tel} {
        allow read:  if member(clubId) && me().get('phone','') == tel;
        allow write: if staff(clubId);
      }
      match /teams/{id}        { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /events/{id}       { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /benevoles/{id}    { allow read: if readStaff(clubId); allow write: if staff(clubId); }
      match /evaluations/{id}  { allow read: if readMember(clubId); allow write: if staff(clubId); }
      // Stats de match (saisie du coach) : staff seulement. Un parent ne lit jamais
      // les chiffres des autres enfants ; sa vue « mon enfant » viendra d'un document à part.
      match /match_stats/{id}  { allow read: if readStaff(clubId); allow write: if staff(clubId); }
      // Une fiche de licence contient l'adresse, les coordonnees des responsables
      // legaux, le certificat medical et la photo d'un mineur. Elle ne regarde que
      // le staff : jusqu'ici tout membre du club pouvait lire toutes les fiches.
      match /licences/{id}     { allow read: if readStaff(clubId);  allow write: if staff(clubId); }
      match /checkins/{id}     { allow read: if readMember(clubId); allow write: if member(clubId); }
      match /joinRequests/{id} { allow read: if readMember(clubId); allow write: if member(clubId); }

      // ── Communauté ──
      match /channels/{chanId} {
        allow read: if readMember(clubId);
        allow write: if staff(clubId);
        match /messages/{msgId} {
          allow read: if readMember(clubId);
          // On ne poste qu'en son propre nom.
          allow create: if member(clubId)
            && request.resource.data.get('senderUid', null) in [request.auth.uid, null];
          allow update: if member(clubId) && (staff(clubId) || auteurPeut() || champsPartages());
          allow delete: if staff(clubId);
        }
        // Lu par (coches bleues) : chacun ne note que sa propre lecture.
        match /reads/{uid} {
          allow read: if readMember(clubId);
          allow write: if member(clubId) && request.auth.uid == uid;
        }
        // "... écrit" : indicateur éphémère.
        match /typing/{pseudo} {
          allow read, write: if member(clubId);
        }
      }
      match /gallery/{id} {
        allow read: if readMember(clubId);
        allow create, update: if member(clubId);
        allow delete: if staff(clubId);
      }
      match /feedback/{id} {
        allow create: if member(clubId);
        allow read: if readStaff(clubId);
        allow update, delete: if staff(clubId);
      }

      // ── Gestion (données sensibles) ──
      // Caisse buvette (generalmanagerapp.fr/buvette, sans connexion) : le
      // bénévole qui a un code du jour valide peut UNIQUEMENT décrémenter/
      // incrémenter le stock d'un article buvette (jamais son prix, son nom,
      // ni un article matériel) et UNIQUEMENT créer une recette "Buvette/
      // Événements" positive (jamais modifier ou supprimer une ligne
      // existante). Le catalogue buvette (nom/prix/stock, pas le matériel)
      // est lisible sans connexion : c'est un menu, rien de sensible.
      match /comptabilite/{id} {
        allow read: if readDirigeant(clubId) || hasPermission(clubId, 'comptabilite');
        allow write: if dirigeant(clubId) || hasPermission(clubId, 'comptabilite');
        allow create: if buvetteCodeValid(clubId, request.resource.data.get('viaCode',''))
          && request.resource.data.type == 'recette'
          && request.resource.data.categorie == 'Buvette/Événements'
          && request.resource.data.montant is number && request.resource.data.montant > 0;
      }
      match /inventaire/{id} {
        allow read: if readDirigeant(clubId) || resource.data.get('categorie', null) == 'buvette' || hasPermission(clubId, 'inventaire');
        allow write: if dirigeant(clubId) || hasPermission(clubId, 'inventaire');
        allow update: if buvetteCodeValid(clubId, request.resource.data.get('viaCode',''))
          && resource.data.categorie == 'buvette'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qte','viaCode']);
      }
      // Journal des ventes de la caisse buvette : trace de chaque journée,
      // consultable (et exportable en PDF) dans l'Inventaire, quel que soit le
      // pack. Le bénévole avec un code valide peut seulement AJOUTER une vente.
      match /buvette_ventes/{id} {
        allow read: if readDirigeant(clubId) || hasPermission(clubId, 'inventaire');
        allow delete: if dirigeant(clubId);
        allow create: if buvetteCodeValid(clubId, request.resource.data.get('viaCode',''))
          && request.resource.data.keys().hasOnly(['id','viaCode','benevole','date','t','mode','total','lignes'])
          && request.resource.data.total is number && request.resource.data.total > 0
          && request.resource.data.lignes is list && request.resource.data.lignes.size() <= 100;
      }
      // Procédure de la caisse buvette : texte écrit par le dirigeant (ou le
      // module inventaire), lisible sans connexion par la page caisse (rien de
      // sensible : des consignes). Le bénévole ne peut rien y écrire.
      match /buvette_procedure/{id} {
        allow get: if true;
        allow create, update: if (dirigeant(clubId) || hasPermission(clubId, 'inventaire'))
          && request.resource.data.keys().hasOnly(['blocs','maj'])
          && request.resource.data.blocs is list && request.resource.data.blocs.size() <= 20;
        allow delete: if dirigeant(clubId) || hasPermission(clubId, 'inventaire');
      }
      match /sponsors/{id} {
        allow read: if readDirigeant(clubId) || hasPermission(clubId, 'sponsors');
        allow write: if dirigeant(clubId) || hasPermission(clubId, 'sponsors');
      }
      // Compteur de numérotation des factures sponsors : à part de la fiche
      // club (réservée au dirigeant) pour qu'un trésorier/bureau délégué sur
      // Sponsors puisse réserver un numéro sans toucher au doc clubs/{clubId}.
      match /facturation_compteur/{id} {
        allow read, write: if dirigeant(clubId) || hasPermission(clubId, 'sponsors');
      }
      // Plan comptable du club (exercice, comptes par catégorie) : même droit
      // que la compta, pour que le trésorier délégué puisse le régler.
      match /compta_reglages/{id} {
        allow read: if readDirigeant(clubId) || hasPermission(clubId, 'comptabilite');
        allow write: if dirigeant(clubId) || hasPermission(clubId, 'comptabilite');
      }
      match /backups/{id}      { allow read: if readDirigeant(clubId); allow write: if dirigeant(clubId); }
      match /notes_frais/{id}  { allow read: if readStaff(clubId);     allow write: if staff(clubId); }
      match /annuaire/{id}     { allow read: if readStaff(clubId);     allow write: if staff(clubId); }

      // ── Réglages du club ──
      match /app_data/{id}       { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /reminders_sent/{id} { allow read: if readMember(clubId); allow write: if staff(clubId); }

      // Abonnements push (js/22-push.js) : un membre ne gère que son propre
      // abonnement (id = son uid). Jamais lu côté client — seule la Cloud
      // Function (functions/index.js) les lit, avec la clé Admin qui ignore
      // ces règles.
      match /push_subscriptions/{uid} {
        allow read, write: if member(clubId) && signedIn() && request.auth.uid==uid;
      }
      // Test de notification (Communauté › réglages) : chacun crée et lit son propre test.
      match /push_ping/{id} {
        allow create: if member(clubId) && request.resource.data.keys().hasOnly(['at','uid'])
          && request.resource.data.uid == request.auth.uid;
        allow read: if member(clubId) && resource.data.get('uid', '') == request.auth.uid;
      }

      // ── Discussions privées (2 personnes : un membre du staff et un adulte du
      // club). Ouvertes par le staff seulement ; personne d'autre ne les lit,
      // pas même le dirigeant s'il n'en fait pas partie.
      match /dms/{dmId} {
        function dansLaDiscussion() {
          return member(clubId) && request.auth.uid in
            get(/databases/$(database)/documents/clubs/$(clubId)/dms/$(dmId)).data.get('memberUids', []);
        }
        allow read: if member(clubId) && request.auth.uid in resource.data.get('memberUids', []);
        allow create: if staff(clubId)
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == 2
          && request.auth.uid in request.resource.data.memberUids;
        allow update: if member(clubId) && request.auth.uid in resource.data.get('memberUids', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg','lastTs','lastSender']);
        // Pas de suppression côté client : « supprimer » masque la discussion pour soi
        // (reads/{uid}.masque) ; l'effacement réel est fait par une fonction planifiée.
        match /messages/{msgId} {
          allow read: if dansLaDiscussion();
          allow create: if dansLaDiscussion() && request.resource.data.get('senderUid', null) == request.auth.uid;
          allow update: if dansLaDiscussion() && (auteurPeut() || champsPartages());
        }
        match /reads/{uid} {
          allow read: if dansLaDiscussion();
          allow write: if dansLaDiscussion() && request.auth.uid == uid;
        }
      }

      // ── Indépendants : clients, créneaux, séances, réservations ──
      // Fiche du client : lui seul et l'indépendant la lisent. Le client la crée
      // juste après son compte (lien d'invitation) et peut corriger ses infos.
      match /indep_clients/{uid} {
        function ficheOk(d) {
          return d.prenom is string && d.prenom.size() >= 1 && d.prenom.size() <= 40
            && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 40
            && d.get('naissance', '') is string && d.get('naissance', '').size() <= 10
            && d.get('tel', '') is string && d.get('tel', '').size() <= 20
            && d.get('email', '') is string && d.get('email', '').size() <= 100
            && d.get('note', '') is string && d.get('note', '').size() <= 300
            && d.get('parentSeul', false) is bool;
        }
        // Enfant mineur : fiche créée par son parent (compte adulte, rôle client).
        // Identifiant « e_xxxx » (jamais un uid de compte), parentUid = le parent,
        // autorisation parentale cochée et horodatée. Aucun compte pour l'enfant.
        function enfantOk(d) {
          return d.prenom is string && d.prenom.size() >= 1 && d.prenom.size() <= 40
            && d.nom is string && d.nom.size() >= 1 && d.nom.size() <= 40
            && d.naissance is string && d.naissance.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.get('note', '') is string && d.get('note', '').size() <= 300;
        }
        allow read: if readDirigeant(clubId)
          || (member(clubId) && (request.auth.uid == uid || resource.data.get('parentUid', '') == request.auth.uid));
        allow create: if dirigeant(clubId)
          || (member(clubId) && hasRole('client') && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['prenom','nom','naissance','tel','email','note','parentSeul','createdAt'])
              && ficheOk(request.resource.data) && request.resource.data.createdAt == request.time)
          || (member(clubId) && hasRole('client') && uid.matches('^e_[a-z0-9]{6,30}$')
              && request.resource.data.keys().hasOnly(['prenom','nom','naissance','note','parentUid','mineur','autorisation','createdAt'])
              && request.resource.data.parentUid == request.auth.uid
              && request.resource.data.mineur == true && request.resource.data.autorisation == true
              && enfantOk(request.resource.data) && request.resource.data.createdAt == request.time);
        allow update: if dirigeant(clubId)
          || (member(clubId) && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prenom','nom','naissance','tel','email','note','parentSeul'])
              && ficheOk(request.resource.data))
          || (member(clubId) && hasRole('client') && resource.data.get('parentUid', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prenom','nom','naissance','note'])
              && enfantOk(request.resource.data));
        allow delete: if dirigeant(clubId);
      }
      // Notes de l'indépendant sur un client : jamais visibles du client.
      match /indep_notes/{uid}    { allow read: if readDirigeant(clubId); allow write: if dirigeant(clubId); }
      // Créneaux hebdomadaires et séances (exceptions, annulations, ponctuelles).
      match /indep_creneaux/{id}  { allow read: if readMember(clubId); allow write: if dirigeant(clubId); }
      match /indep_seances/{id}   { allow read: if readMember(clubId); allow write: if dirigeant(clubId); }
      // Réservation d'un client à une séance : id = séance__uid. Le client ne
      // touche qu'à la sienne (je viens / je ne viens pas) ; la présence est
      // pointée par l'indépendant seul.
      match /indep_resas/{id} {
        function resaOk(d) {
          return d.seance is string && d.seance.size() >= 1 && d.seance.size() <= 120
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.statut in ['vient', 'absent']
            && d.get('nom', '') is string && d.get('nom', '').size() <= 60;
        }
        // La personne réservée est le client lui-même ou l'un de SES enfants.
        function parentDe(clubId, pid) {
          return pid is string && pid.matches('^e_[a-z0-9]{6,30}$')
            && get(/databases/$(database)/documents/clubs/$(clubId)/indep_clients/$(pid)).data.get('parentUid', '') == request.auth.uid;
        }
        allow read: if readMember(clubId);
        allow create: if dirigeant(clubId)
          || (member(clubId) && hasRole('client')
              && request.resource.data.keys().hasOnly(['seance','date','uid','statut','nom','at'])
              && (request.resource.data.uid == request.auth.uid || parentDe(clubId, request.resource.data.uid))
              && id == request.resource.data.seance + '__' + request.resource.data.uid
              && resaOk(request.resource.data) && request.resource.data.at == request.time);
        allow update: if dirigeant(clubId)
          || (member(clubId) && hasRole('client') && (resource.data.uid == request.auth.uid || parentDe(clubId, resource.data.uid))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','nom','at'])
              && resaOk(request.resource.data) && request.resource.data.at == request.time);
        allow delete: if dirigeant(clubId);
      }

      // Annonces de l'indépendant à ses clients (tous, ou les habitués d'un créneau),
      // avec une séance jointe en option. Les clients les lisent, seul l'indépendant écrit.
      match /indep_annonces/{id} {
        function annonceOk(d) {
          return d.texte is string && d.texte.size() >= 1 && d.texte.size() <= 1000
            && d.cible is string && d.cible.size() >= 1 && d.cible.size() <= 120
            && d.get('seance', '') is string && d.get('seance', '').size() <= 120
            && d.get('seanceDate', '') is string && d.get('seanceDate', '').size() <= 10;
        }
        allow read: if readMember(clubId);
        allow create: if dirigeant(clubId)
          && request.resource.data.keys().hasOnly(['texte','cible','seance','seanceDate','createdAt'])
          && annonceOk(request.resource.data) && request.resource.data.createdAt == request.time;
        allow update: if dirigeant(clubId) && annonceOk(request.resource.data);
        allow delete: if dirigeant(clubId);
      }
      // Réponse d'un client à une annonce : 👍🏼 (up) ou 👎🏼 (down). id = annonce__personne.
      // La personne est le client lui-même ou l'un de SES enfants ; « owner » = le compte
      // qui répond (le parent), ce qui permet de ne lui faire lire que ses réponses.
      match /indep_reactions/{id} {
        function parentDeReac(clubId, pid) {
          return pid is string && pid.matches('^e_[a-z0-9]{6,30}$')
            && get(/databases/$(database)/documents/clubs/$(clubId)/indep_clients/$(pid)).data.get('parentUid', '') == request.auth.uid;
        }
        function reacOk(d) {
          return d.annonce is string && d.annonce.size() >= 1 && d.annonce.size() <= 120
            && d.val in ['up', 'down']
            && d.get('nom', '') is string && d.get('nom', '').size() <= 60;
        }
        allow read: if readDirigeant(clubId)
          || (member(clubId) && resource.data.get('owner', '') == request.auth.uid);
        allow create: if member(clubId) && hasRole('client')
          && request.resource.data.keys().hasOnly(['annonce','uid','owner','val','nom','at'])
          && request.resource.data.owner == request.auth.uid
          && (request.resource.data.uid == request.auth.uid || parentDeReac(clubId, request.resource.data.uid))
          && id == request.resource.data.annonce + '__' + request.resource.data.uid
          && reacOk(request.resource.data) && request.resource.data.at == request.time;
        allow update: if member(clubId) && hasRole('client') && resource.data.owner == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['val','nom','at'])
          && reacOk(request.resource.data) && request.resource.data.at == request.time;
        allow delete: if dirigeant(clubId);
      }

      // Discussion privée entre un client (compte adulte, parent pour ses enfants) et
      // l'indépendant : un fil par client, id = uid du compte. La fiche du fil porte
      // l'aperçu du dernier message et les heures de lecture (pastilles « non lu »).
      match /indep_discussions/{uid} {
        function discOk(d) {
          return d.get('nom', '') is string && d.get('nom', '').size() <= 60
            && d.get('dernier', '') is string && d.get('dernier', '').size() <= 80
            && d.dernierDe in ['client', 'coach'];
        }
        allow read: if readDirigeant(clubId) || (member(clubId) && request.auth.uid == uid);
        allow create: if (dirigeant(clubId)
              && request.resource.data.keys().hasOnly(['nom','dernier','dernierTs','dernierDe','luCoach'])
              && discOk(request.resource.data) && request.resource.data.dernierDe == 'coach'
              && request.resource.data.dernierTs == request.time)
          || (member(clubId) && hasRole('client') && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['nom','dernier','dernierTs','dernierDe'])
              && discOk(request.resource.data) && request.resource.data.dernierDe == 'client'
              && request.resource.data.dernierTs == request.time);
        allow update: if (dirigeant(clubId)
              && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luCoach'])
                    && request.resource.data.luCoach == request.time)
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nom','dernier','dernierTs','dernierDe'])
                    && discOk(request.resource.data) && request.resource.data.dernierDe == 'coach'
                    && request.resource.data.dernierTs == request.time)))
          || (member(clubId) && hasRole('client') && request.auth.uid == uid
              && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luClient'])
                    && request.resource.data.luClient == request.time)
                  || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nom','dernier','dernierTs','dernierDe'])
                    && discOk(request.resource.data) && request.resource.data.dernierDe == 'client'
                    && request.resource.data.dernierTs == request.time)));
        allow delete: if dirigeant(clubId);

        // Messages : texte et/ou une photo (JPEG réduit, en texte data:). Jamais modifiés.
        match /messages/{mid} {
          function msgOk(d, de) {
            return d.de == de && d.auteur == request.auth.uid
              && d.get('texte', '') is string && d.get('texte', '').size() <= 1000
              && d.get('img', '') is string && d.get('img', '').size() <= 350000
              && (d.get('texte', '').size() > 0 || d.get('img', '').size() > 0)
              && d.createdAt == request.time;
          }
          allow read: if readDirigeant(clubId) || (member(clubId) && request.auth.uid == uid);
          allow create: if request.resource.data.keys().hasOnly(['de','auteur','texte','img','createdAt'])
            && ((dirigeant(clubId) && msgOk(request.resource.data, 'coach'))
              || (member(clubId) && hasRole('client') && request.auth.uid == uid && msgOk(request.resource.data, 'client')));
          allow delete: if dirigeant(clubId);
        }
      }

      // Argent de l'indépendant (js/24b-independant-argent.js) : séances à payer, payées ou prises
      // sur un pass, et pass vendus. Écrit par l'indépendant seul ; lu par lui et par le compte
      // payeur (le client, ou le parent pour son enfant). L'appli ne touche jamais à l'argent.
      match /indep_lignes/{id} {
        function ligneOk(d) {
          return d.type in ['seance', 'pass'] && d.statut in ['du', 'paye', 'pass']
            && d.uid is string && d.uid.size() >= 1 && d.uid.size() <= 60
            && d.compte is string && d.compte.size() >= 1 && d.compte.size() <= 60
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.montant is number && d.montant >= 0 && d.montant <= 100000
            && d.get('libelle', '') is string && d.get('libelle', '').size() <= 120
            && d.get('mode', '') in ['', 'especes', 'virement', 'cheque', 'en_ligne']
            && d.get('datePaiement', '') is string && d.get('datePaiement', '').size() <= 10
            && d.get('usages', []) is list && d.get('usages', []).size() <= 200;
        }
        allow read: if readDirigeant(clubId)
          || (member(clubId) && resource.data.get('compte', '') == request.auth.uid);
        allow create, update: if dirigeant(clubId) && ligneOk(request.resource.data);
        allow delete: if dirigeant(clubId);
      }

      // Purge : lecture et suppression sur TOUTES les sous-collections de ce
      // club, uniquement pendant la fenetre ci-dessus. Un match recursif evite
      // d'oublier une collection — une sous-collection ajoutee plus tard y sera
      // couverte automatiquement.
      match /{sousCollection=**} {
        allow read, delete: if purgeWindow(clubId);
      }

      // ── Fiches d'inscription déposées publiquement ──
      match /inscription_submissions/{id} {
        allow create: if request.resource.data.code is string
          && get(/databases/$(database)/documents/inscription_codes/$(request.resource.data.code)).data.clubId == clubId;
        allow read: if readStaff(clubId);
        allow update, delete: if staff(clubId);
      }

      // Inscription à un événement (stage, tournoi, soirée), sans compte depuis
      // la page publique, ou par un parent connecté pour SON enfant (playerId
      // rattaché). Le compteur de la page publique monte dans la même opération.
      // Id = code du billet (STG-12345, TRN-…, SOI-…, EVT-…).
      match /evt_inscrits/{code} {
        function evtPage(eventId) { return /databases/$(database)/documents/evt_pages/$(clubId + '__' + eventId); }
        // Prix du billet : tarif fixe, ou « par jour » (jours choisis parmi ceux de la page,
        // forfait facultatif quand tous les jours sont pris).
        // Soirée (resa) : quantités par tarif (4 au plus), total de personnes et prix recalculés.
        function rq(d, k) { return d.qte.get(k, 0); }
        function rpx(p, i) { return p.tarifs.size() > i ? p.tarifs[i].prix : 0; }
        function rqOk(d, p, k, i) { return rq(d, k) is int && rq(d, k) >= 0 && rq(d, k) <= 20 && (p.tarifs.size() > i || rq(d, k) == 0); }
        function evtResaOk(p, d) {
          return d.get('qte', null) is map && d.qte.keys().hasOnly(['0','1','2','3'])
            && rqOk(d, p, '0', 0) && rqOk(d, p, '1', 1) && rqOk(d, p, '2', 2) && rqOk(d, p, '3', 3)
            && d.get('personnes', 0) is int && d.personnes >= 1 && d.personnes <= 40
            && d.personnes == rq(d, '0') + rq(d, '1') + rq(d, '2') + rq(d, '3')
            && !('jours' in d)
            && math.abs(d.montant - (rq(d, '0') * rpx(p, 0) + rq(d, '1') * rpx(p, 1) + rq(d, '2') * rpx(p, 2) + rq(d, '3') * rpx(p, 3))) < 0.01;
        }
        function evtMontantOk(p, d) {
          return p.get('resa', false) == true ? evtResaOk(p, d)
            : ('qte' in d || 'personnes' in d) ? false
            : p.get('parJour', false) != true
            ? (!('jours' in d) && d.montant == p.tarifs[d.tarifIdx].prix)
            : (d.get('jours', null) is list && d.jours.size() >= 1 && d.jours.size() <= 14
               && d.jours.toSet().size() == d.jours.size()
               && d.jours.hasOnly(p.jours)
               && math.abs(d.montant - ((p.tarifs[d.tarifIdx].get('forfait', 0) > 0 && d.jours.size() == p.jours.size())
                    ? p.tarifs[d.tarifIdx].forfait : p.tarifs[d.tarifIdx].prix * d.jours.size())) < 0.01);
        }
        allow create: if clubStatus(clubId) == 'active'
          && code.matches('^(STG|TRN|SOI|EVT)-[0-9]{5}$')
          && request.resource.data.keys().hasOnly(['eventId','prenom','nom','naissance','tel','clubOrigine','tarifIdx','tarifNom','montant','jours','cat','email','mode','statut','paye','present','playerId','auteurUid','source','at','qte','personnes'])
          && request.resource.data.eventId is string
          && get(evtPage(request.resource.data.eventId)).data.actif == true
          && get(evtPage(request.resource.data.eventId)).data.clubId == clubId
          && getAfter(evtPage(request.resource.data.eventId)).data.get('nb', 0) == get(evtPage(request.resource.data.eventId)).data.get('nb', 0) + request.resource.data.get('personnes', 1)
          && getAfter(evtPage(request.resource.data.eventId)).data.get('dernier', '') == code
          && request.resource.data.prenom is string && request.resource.data.prenom.size() >= 1 && request.resource.data.prenom.size() <= 40
          && request.resource.data.nom is string && request.resource.data.nom.size() >= 1 && request.resource.data.nom.size() <= 60
          // Soirée : pas de date de naissance (une réservation de famille).
          && (get(evtPage(request.resource.data.eventId)).data.get('resa', false) == true
              ? !('naissance' in request.resource.data)
              : (request.resource.data.naissance is string && request.resource.data.naissance.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && request.resource.data.tel is string && request.resource.data.tel.matches('^[+]?[0-9]{9,15}$')
          && request.resource.data.get('clubOrigine', '') is string && request.resource.data.get('clubOrigine', '').size() <= 60
          && request.resource.data.get('cat', '') is string && request.resource.data.get('cat', '').size() <= 12
          && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 100
          && request.resource.data.tarifIdx is int
          && evtMontantOk(get(evtPage(request.resource.data.eventId)).data, request.resource.data)
          && request.resource.data.mode in ['especes','cheque','cb','helloasso','gratuit']
          && (request.resource.data.mode != 'gratuit' || request.resource.data.montant == 0)
          && request.resource.data.statut == 'inscrit' && request.resource.data.paye == false && request.resource.data.present == false
          && request.resource.data.at == request.time
          && (!('playerId' in request.resource.data)
              || (signedIn() && request.resource.data.auteurUid == request.auth.uid
                  && request.resource.data.playerId in
                       get(/databases/$(database)/documents/clubs/$(clubId)/rattachements/$(me().get('phone',''))).data.get('playerIds', [])));
        allow read: if readStaff(clubId) || (signedIn() && resource.data.get('auteurUid', '') == request.auth.uid);
        allow update, delete: if staff(clubId);
      }

      // Demande de séance d'essai, déposée sans compte depuis la page publique
      // du club, seulement quand le dirigeant l'a ouverte. Lecture réservée au staff.
      match /essais/{id} {
        allow create: if clubStatus(clubId) == 'active'
          && get(/databases/$(database)/documents/essai_pages/$(clubId)).data.get('actif', false) == true
          && request.resource.data.keys().hasOnly(['equipeId','equipeNom','prenom','naissance','parentNom','tel','message','statut','at'])
          && request.resource.data.equipeId is string && request.resource.data.equipeId.size() <= 60
          && request.resource.data.equipeNom is string && request.resource.data.equipeNom.size() <= 60
          && request.resource.data.prenom is string && request.resource.data.prenom.size() >= 1 && request.resource.data.prenom.size() <= 40
          && request.resource.data.naissance is string && request.resource.data.naissance.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.parentNom is string && request.resource.data.parentNom.size() >= 2 && request.resource.data.parentNom.size() <= 60
          && request.resource.data.tel is string && request.resource.data.tel.matches('^[+]?[0-9]{9,15}$')
          && request.resource.data.get('message', '') is string && request.resource.data.get('message', '').size() <= 300
          && request.resource.data.statut == 'nouvelle'
          && request.resource.data.at == request.time;
        allow read: if readStaff(clubId);
        allow update, delete: if staff(clubId);
      }

      // Réinscription en ligne : un parent redemande une licence pour SON enfant
      // (celui que le club lui a rattaché), seulement pendant l'ouverture décidée
      // par le club et pour la saison annoncée. Le staff l'importe en licence.
      match /reinscriptions/{id} {
        allow create: if member(clubId)
          && request.resource.data.auteurUid == request.auth.uid
          && request.resource.data.statut == 'nouvelle'
          && request.resource.data.playerId in
               get(/databases/$(database)/documents/clubs/$(clubId)/rattachements/$(me().get('phone',''))).data.get('playerIds', [])
          && get(/databases/$(database)/documents/clubs/$(clubId)/app_data/reinscriptions).data.get('ouvert', false) == true
          && request.resource.data.saison ==
               get(/databases/$(database)/documents/clubs/$(clubId)/app_data/reinscriptions).data.get('saison', '');
        allow read: if readStaff(clubId) || (member(clubId) && resource.data.auteurUid == request.auth.uid);
        allow update, delete: if staff(clubId);
      }
    }

    // ── Index publics (lecture avant connexion) ─────────────────────
    // phone_index a existé pour router un numéro vers son club avant
    // connexion (auto-inscription parent). Retiré : les comptes se créent
    // désormais par invitation, plus aucun numéro n'est exposé publiquement.
    match /inscription_codes/{code} {
      allow read: if true;
      allow create: if staff(request.resource.data.clubId);
      allow update: if staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId;
      // staff(clubId) redevient faux dès que le club passe en "purging" : sans
      // purgeWindow, la purge de ces codes par le super admin (deleteClubFlow)
      // échouait, exactement comme pour support_grants/buvette_codes ci-dessus.
      allow delete: if staff(resource.data.clubId) || purgeWindow(resource.data.clubId);
    }

    // Tout le reste (dont les anciennes collections à la racine) : refusé.
    match /{document=**} { allow read, write: if false; }
  }
}
