rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  General Manager — règles de sécurité Firestore (multi-club)
//
//  3 niveaux d'accès :
//   1. Super admin (éditeur de la plateforme) : crée les clubs, invite leur
//      dirigeant, peut suspendre un club. N'a AUCUN accès aux données internes
//      d'un club, sauf code d'accès support fourni par ce club (lecture seule).
//   2. Dirigeant d'un club : gère son club, invite son staff.
//   3. Membres (coachs, parents, joueurs) : accès limité à leur club.
//
//  Toutes les données d'un club vivent sous clubs/{clubId}/... .
//  Collections globales : users, clubs, phone_index, inscription_codes,
//  club_invites, support_grants.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions communes ──────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function superAdmin() {
      return signedIn() && request.auth.uid == "7f2br1aTiJVWHTEbqVePbMLD0uc2";
    }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(userPath()).data; }
    function clubPath(clubId) { return /databases/$(database)/documents/clubs/$(clubId); }

    // Un club suspendu (abonnement) n'est plus accessible à ses membres.
    // Le club doit exister ET ne pas etre suspendu. Un simple "n'existe pas donc
    // pas suspendu" rendrait l'acces a un club supprime PLUS large qu'a un club
    // suspendu : ses membres garderaient leurs droits sur des donnees devenues
    // invisibles depuis la plateforme.
    function clubStatus(clubId) {
      return get(clubPath(clubId)).data.get('status', 'active');
    }
    // Le club doit exister ET etre actif. Un simple "n'existe pas donc pas
    // suspendu" rendrait l'acces a un club supprime PLUS large qu'a un club
    // suspendu. 'purging' bloque aussi : pendant l'effacement, les membres ne
    // doivent pas continuer a ecrire dans des collections en cours de purge.
    function notSuspended(clubId) {
      return exists(clubPath(clubId))
        && !(clubStatus(clubId) in ['suspended', 'deleted', 'purging']);
    }

    // Fenetre de purge. Le super admin n'a aucun droit sur les donnees d'un
    // club ; cette fenetre est la seule exception, et elle est bornee :
    //  - le club doit porter le statut 'purging', que seul le super admin pose ;
    //  - purgeUntil doit exister et n'etre pas encore echu, donc la fenetre se
    //    referme d'elle-meme meme si la purge est interrompue ou oubliee ;
    //  - elle ouvre lecture et suppression, jamais l'ecriture : on ne peut pas
    //    modifier les donnees d'un club, seulement les lister et les effacer.
    // Le club voit ce statut depuis son ecran de suspension.
    function purgeWindow(clubId) {
      return superAdmin()
        && exists(clubPath(clubId))
        && clubStatus(clubId) == 'purging'
        && get(clubPath(clubId)).data.get('purgeUntil', request.time) > request.time;
    }
    function member(clubId) {
      return signedIn() && exists(userPath()) && me().get('clubId', null) == clubId && notSuspended(clubId);
    }
    function hasRole(r) { return me().get('roles', []).hasAny([r]); }
    function staff(clubId)     { return member(clubId) && (hasRole('dirigeant') || hasRole('coach')); }
    function dirigeant(clubId) { return member(clubId) && hasRole('dirigeant'); }

    // Accès support : le super admin lit un club UNIQUEMENT s'il a ouvert une
    // session avec un code encore valide, que le club n'a pas révoqué.
    function supportActive(clubId) {
      let s = /databases/$(database)/documents/clubs/$(clubId)/support_sessions/$(request.auth.uid);
      return superAdmin() && exists(s)
        && get(s).data.expiresAt > request.time
        && exists(/databases/$(database)/documents/support_grants/$(get(s).data.code));
    }
    function readMember(clubId)    { return member(clubId)    || supportActive(clubId); }
    function readStaff(clubId)     { return staff(clubId)     || supportActive(clubId); }
    function readDirigeant(clubId) { return dirigeant(clubId) || supportActive(clubId); }

    function changes(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Invitation valide pour ce club et ce rôle (non utilisée, non expirée)
    function invitePath(code) { return /databases/$(database)/documents/club_invites/$(code); }
    function inviteValid(code, clubId, roles) {
      let inv = get(invitePath(code)).data;
      return inv.usedBy == null && inv.expiresAt > request.time
        && inv.clubId == clubId && roles == [inv.role];
    }

    // ── Comptes utilisateurs ────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || dirigeant(resource.data.get('clubId', null)) || superAdmin());

      // a) Parent : auto-inscription, club imposé par l'index téléphone
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.roles == ['parent']
        && request.resource.data.phone is string
        && request.resource.data.clubId ==
             get(/databases/$(database)/documents/phone_index/$(request.resource.data.phone)).data.clubId;
      // b) Staff invité : invitation valide ET consommée dans la même opération
      //    (écriture groupée) — une invitation ne sert donc qu'une fois.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.inviteCode is string
        && inviteValid(request.resource.data.inviteCode, request.resource.data.clubId, request.resource.data.roles)
        && getAfter(invitePath(request.resource.data.inviteCode)).data.usedBy == request.auth.uid;
      // c) Compte d'origine du super admin : recréation à l'identique du seed
      //    posé par applyAuthedUser() (même après suppression), jamais avec un
      //    autre club ou un autre rôle — sinon la restriction de l'update
      //    ci-dessous se contournerait par un delete + create.
      allow create: if superAdmin() && request.auth.uid == uid
        && request.resource.data.clubId == "asmb"
        && request.resource.data.roles == ["dirigeant"];

      // Le super admin ne peut pas s'attribuer un clubId à volonté : seul le
      // rattachement unique du compte bootstrap (clubId absent -> club d'origine)
      // est autorisé, exactement ce que fait applyAuthedUser() au premier login.
      // Tout autre club se rejoint via une invitation (branche b ci-dessus).
      allow update: if (signedIn() && request.auth.uid == uid && !changes(['roles','clubId','inviteCode']))
        || (dirigeant(resource.data.get('clubId', null)) && request.resource.data.clubId == resource.data.get('clubId', null))
        || (superAdmin() && request.auth.uid == uid
            && resource.data.get('clubId', null) == null && request.resource.data.clubId == "asmb"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubId']));
      allow delete: if superAdmin();
    }

    // ── Invitations (usage unique, expirent) ────────────────────────
    match /club_invites/{code} {
      allow get: if true;   // consultation par code uniquement (pas de listing public)
      allow list: if superAdmin() || dirigeant(resource.data.clubId);
      allow create: if request.resource.data.usedBy == null
        && (superAdmin()
            || (dirigeant(request.resource.data.clubId) && request.resource.data.role in ['coach','dirigeant']));
      // Consommation : uniquement par la personne qui crée son compte, dans la
      // même opération que la création de ce compte.
      allow update: if signedIn() && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if superAdmin() || dirigeant(resource.data.clubId);
    }

    // ── Codes d'accès support (générés par le club) ─────────────────
    match /support_grants/{code} {
      allow get: if superAdmin();                        // uniquement si on connaît le code
      allow list: if dirigeant(resource.data.clubId);    // le club voit ses codes actifs
      allow create: if dirigeant(request.resource.data.clubId);
      allow delete: if dirigeant(resource.data.clubId);  // révocation
    }

    // ── Clubs ───────────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if member(clubId) || superAdmin();
      allow create, delete: if superAdmin();
      // Le dirigeant personnalise son club ; statut, formule et propriétaire
      // restent du ressort de la plateforme.
      allow update: if (dirigeant(clubId) && !changes(['status','ownerUid','plan'])) || superAdmin();

      // Session support ouverte par le super admin avec un code valide du club
      match /support_sessions/{uid} {
        allow create: if superAdmin() && request.auth.uid == uid
          && get(/databases/$(database)/documents/support_grants/$(request.resource.data.code)).data.clubId == clubId
          && request.resource.data.expiresAt ==
               get(/databases/$(database)/documents/support_grants/$(request.resource.data.code)).data.expiresAt;
        allow read: if (superAdmin() && request.auth.uid == uid) || dirigeant(clubId);
        allow delete: if (superAdmin() && request.auth.uid == uid) || dirigeant(clubId);
      }

      // ── Données sportives ──
      match /players/{id}      { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /teams/{id}        { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /events/{id}       { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /evaluations/{id}  { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /licences/{id}     { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /checkins/{id}     { allow read: if readMember(clubId); allow write: if member(clubId); }
      match /joinRequests/{id} { allow read: if readMember(clubId); allow write: if member(clubId); }

      // ── Communauté ──
      match /channels/{chanId} {
        allow read: if readMember(clubId);
        allow write: if staff(clubId);
        match /messages/{msgId} {
          allow read: if readMember(clubId);
          allow create, update: if member(clubId);
          allow delete: if staff(clubId);
        }
      }
      match /gallery/{id} {
        allow read: if readMember(clubId);
        allow create, update: if member(clubId);
        allow delete: if staff(clubId);
      }
      match /feedback/{id} {
        allow create: if member(clubId);
        allow read: if readStaff(clubId);
        allow update, delete: if staff(clubId);
      }

      // ── Gestion (données sensibles) ──
      match /comptabilite/{id} { allow read: if readDirigeant(clubId); allow write: if dirigeant(clubId); }
      match /inventaire/{id}   { allow read: if readDirigeant(clubId); allow write: if dirigeant(clubId); }
      match /backups/{id}      { allow read: if readDirigeant(clubId); allow write: if dirigeant(clubId); }
      match /notes_frais/{id}  { allow read: if readStaff(clubId);     allow write: if staff(clubId); }
      match /annuaire/{id}     { allow read: if readStaff(clubId);     allow write: if staff(clubId); }

      // ── Réglages du club ──
      match /app_data/{id}       { allow read: if readMember(clubId); allow write: if staff(clubId); }
      match /reminders_sent/{id} { allow read: if readMember(clubId); allow write: if staff(clubId); }

      // Purge : lecture et suppression sur TOUTES les sous-collections de ce
      // club, uniquement pendant la fenetre ci-dessus. Un match recursif evite
      // d'oublier une collection — une sous-collection ajoutee plus tard y sera
      // couverte automatiquement.
      match /{sousCollection=**} {
        allow read, delete: if purgeWindow(clubId);
      }

      // ── Fiches d'inscription déposées publiquement ──
      match /inscription_submissions/{id} {
        allow create: if request.resource.data.code is string
          && get(/databases/$(database)/documents/inscription_codes/$(request.resource.data.code)).data.clubId == clubId;
        allow read: if readStaff(clubId);
        allow update, delete: if staff(clubId);
      }
    }

    // ── Index publics (lecture avant connexion) ─────────────────────
    match /phone_index/{phone} {
      allow read: if true;
      allow create: if staff(request.resource.data.clubId);
      allow update: if staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId;
      allow delete: if staff(resource.data.clubId);
    }
    match /inscription_codes/{code} {
      allow read: if true;
      allow create: if staff(request.resource.data.clubId);
      allow update: if staff(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId;
      allow delete: if staff(resource.data.clubId);
    }

    // Tout le reste (dont les anciennes collections à la racine) : refusé.
    match /{document=**} { allow read, write: if false; }
  }
}
