{
  "name": "gm-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-gm \"node --test rules/*.test.js\"",
    "test:rules:ci": "firebase emulators:exec --only firestore --project demo-gm \"node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./rules/reporter-gh.mjs --test-reporter-destination=stdout rules/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
